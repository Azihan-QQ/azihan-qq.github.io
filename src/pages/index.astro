---
import { profile, experience, skills, projects, hikes } from "../data/profile";
import HeroArt from "../components/HeroArt.astro";
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{profile.name} | Portfolio</title>
    <meta name="description" content={profile.tagline} />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <video autoplay muted loop playsinline poster="/bg/wallpaper.jpg">
        <source src="/bg/wallpaper.mp4" type="video/mp4" />
        <source src="/bg/wallpaper.webm" type="video/webm" />
      </video>
    </div>
    <header class="nav">
      <a href="#" class="logo">
        <span class="logo-mark">A</span>
        <span>
          <strong>{profile.name.toLowerCase()}</strong>
          <small>Info Systems · AR Admin</small>
        </span>
      </a>
      <nav>
        <a href="#about">about</a>
        <a href="#experience">experience</a>
        <a href="#projects">projects</a>
        <a href="#hiking">hiking</a>
        <a href="#contact">contact</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>
          <span class="hi">Hey there,</span>
          <span class="hi">I'm</span>
          <span class="accent big">{profile.name}</span>
        </h1>
        <p class="lead">{profile.tagline}</p>
        <a class="btn" href="#projects">Check my projects</a>
        <HeroArt />
      </section>

      <section id="about" class="wrap">
        <h2>About</h2>
        {profile.about.map((p) => <p>{p}</p>)}
        <ul class="chips">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </section>

      <section id="experience" class="wrap">
        <h2>Experience</h2>
        <div class="stack">
          {experience.map((e) => (
            <article class="card">
              <div class="row">
                <h3>{e.role}</h3>
                <span class="tag">{e.period}</span>
              </div>
              <p class="place">{e.place}</p>
              <ul>
                {e.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="projects" class="wrap">
        <h2>Projects</h2>
        <div class="grid">
          {projects.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <ul class="chips small">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
              {p.url && <a class="link" href={p.url} target="_blank" rel="noopener">Check it out →</a>}
            </article>
          ))}
        </div>
      </section>

      <section id="hiking" class="wrap">
        <h2>Hiking Adventures</h2>
        <p>When I'm not staring at spreadsheets, I'm probably touching grass on some trail.</p>
        <div class="grid">
          {hikes.map((h) => (
            <article class="card hike">
              {h.photo && <img src={h.photo} alt={`View from ${h.name}`} loading="lazy" />}
              <div class="hike-body">
                <div class="row">
                  <h3>{h.name}</h3>
                  <span class="tag">{h.elevation}</span>
                </div>
                <p class="place">{h.date}</p>
                <p>{h.story}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="wrap">
        <h2>Contact</h2>
        <p>Wanna chat or collab? Slide into my links:</p>
        <div class="actions">
          {profile.links.map((l) => (
            <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>
          ))}
        </div>
      </section>
    </main>

    <footer class="wrap">© {year} {profile.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f2242;
    --text: #ffffff;
    --navy: #0f2242;
    --navy-deep: #08152b;
    --sky: #7cc4ff;
    --blue: #2f6db5;
    --gold: #ffc857;
    --paper: #ffffff;
  }
  * { box-sizing: border-box; }

  /* live wallpaper: video di belakang semua konten, ditimpa lapisan navy biar teks tetap kebaca */
  .bg { position: fixed; inset: 0; z-index: -1; background: var(--bg) url("/bg/wallpaper.jpg") center / cover; }
  .bg video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(15, 34, 66, 0.55) 0%, rgba(15, 34, 66, 0.8) 45%, rgba(8, 21, 43, 0.92) 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .bg video { display: none; }
  }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Montserrat", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-weight: 500;
    line-height: 1.65;
  }
  a { color: inherit; }
  .wrap { max-width: 900px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; }

  /* nav */
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px; padding: 18px 24px;
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-mark {
    display: grid; place-items: center; width: 40px; height: 40px;
    border: 3px solid var(--sky); border-radius: 50%; background: var(--paper); color: var(--navy);
    font-weight: 900; font-size: 1.1rem;
  }
  .logo strong { display: block; font-weight: 900; line-height: 1.1; }
  .logo small { display: block; font-size: 0.7rem; font-weight: 600; }
  .nav nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 0.9rem; font-weight: 600; }
  .nav nav a { text-decoration: none; }
  .nav nav a:hover { text-decoration: underline; text-decoration-thickness: 2px; }

  /* hero */
  .hero { padding-top: 56px; padding-bottom: 24px; max-width: 640px; }
  h1 {
    margin: 0; font-weight: 900; text-transform: uppercase;
    font-size: clamp(2.6rem, 9vw, 4.2rem); line-height: 1.02; letter-spacing: 0.01em;
  }
  h1 span { display: block; }
  h1 .big { font-size: 1.25em; }
  .hi { color: var(--text); }
  .accent { color: var(--sky); }
  .lead { font-size: 1.15rem; font-weight: 700; margin: 20px 0 28px; }

  .btn {
    display: inline-block; padding: 12px 22px; border-radius: 6px;
    background: var(--paper); color: var(--navy); text-decoration: none;
    font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em;
    border: 3px solid var(--paper); box-shadow: 4px 4px 0 var(--sky);
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .btn:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--sky); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }

  /* sections */
  section { padding-top: 72px; padding-bottom: 8px; }
  h2 {
    font-weight: 900; text-transform: uppercase; font-size: clamp(1.8rem, 6vw, 2.6rem);
    line-height: 1.1; margin: 0 0 20px; color: var(--sky);
  }
  section:nth-of-type(odd) h2 { color: var(--text); }
  h3 { font-size: 1.1rem; font-weight: 800; margin: 0; }

  .card {
    background: var(--paper); color: var(--navy); border: 3px solid var(--navy-deep); border-radius: 12px;
    padding: 20px; box-shadow: 6px 6px 0 var(--sky);
  }
  .card p { margin: 8px 0; }
  .card ul:not(.chips) { margin: 8px 0 0; padding-left: 20px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .place { font-weight: 700; color: var(--blue); }
  .tag {
    font-size: 0.75rem; font-weight: 800; padding: 2px 10px; border-radius: 999px;
    background: var(--navy); color: #fff; border: 2px solid var(--navy);
  }
  .stack { display: grid; gap: 22px; }
  .grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }

  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; }
  .chips li {
    padding: 4px 12px; border-radius: 999px; font-size: 0.85rem; font-weight: 700;
    border: 2px solid var(--sky); background: transparent;
  }
  .card .chips li { border-color: var(--navy); background: #eaf3ff; color: var(--navy); }
  .chips.small { margin: 12px 0; }
  .chips.small li { font-size: 0.75rem; padding: 2px 10px; }
  .link { font-weight: 800; color: var(--blue); }

  .hike { padding: 0; overflow: hidden; }
  .hike img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-bottom: 3px solid var(--navy-deep); }
  .hike-body { padding: 16px 20px 20px; }

  footer { padding-top: 56px; padding-bottom: 40px; font-weight: 700; font-size: 0.85rem; }

  @media (max-width: 560px) {
    .nav { padding: 16px; }
    .nav nav { gap: 12px; font-size: 0.85rem; }
  }
</style>
