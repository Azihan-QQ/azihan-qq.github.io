---
import { profile, experience, skills, projects, hikes } from "../data/profile";
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{profile.name} | Portfolio</title>
    <meta name="description" content={profile.tagline} />
  </head>
  <body>
    <header class="wrap nav">
      <a href="#" class="logo">{profile.name}</a>
      <nav>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#hiking">Hiking</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main class="wrap">
      <section class="hero">
        <p class="eyebrow">Hey there, I'm</p>
        <h1>{profile.name}</h1>
        <p class="lead">{profile.tagline}</p>
        <div class="actions">
          <a class="btn primary" href="#projects">Check my projects</a>
          <a class="btn" href="#contact">Hit me up</a>
        </div>
      </section>

      <section id="about">
        <h2>About</h2>
        {profile.about.map((p) => <p>{p}</p>)}
        <ul class="chips">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </section>

      <section id="experience">
        <h2>Experience</h2>
        <div class="timeline">
          {experience.map((e) => (
            <article class="card">
              <div class="row">
                <h3>{e.role}</h3>
                <span class="muted">{e.period}</span>
              </div>
              <p class="muted">{e.place}</p>
              <ul>
                {e.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="projects">
        <h2>Projects</h2>
        <div class="grid">
          {projects.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <ul class="chips small">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
              {p.url && <a href={p.url} target="_blank" rel="noopener">Check it out →</a>}
            </article>
          ))}
        </div>
      </section>

      <section id="hiking">
        <h2>Hiking Adventures</h2>
        <p class="muted">When I'm not staring at spreadsheets, I'm probably touching grass on some trail.</p>
        <div class="grid">
          {hikes.map((h) => (
            <article class="card hike">
              {h.photo && <img src={h.photo} alt={`View from ${h.name}`} loading="lazy" />}
              <div class="row">
                <h3>{h.name}</h3>
                <span class="muted">{h.elevation}</span>
              </div>
              <p class="muted">{h.date}</p>
              <p>{h.story}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>Wanna chat or collab? Slide into my links:</p>
        <div class="actions">
          {profile.links.map((l) => (
            <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>
          ))}
        </div>
      </section>
    </main>

    <footer class="wrap muted">© {year} {profile.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #1c1917;
    --muted: #78716c;
    --card: #ffffff;
    --border: #e7e5e4;
    --accent: #0d9488;
    --accent-fg: #ffffff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --card: #1c1917;
      --border: #292524;
      --accent: #2dd4bf;
      --accent-fg: #042f2e;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px; padding-top: 20px; padding-bottom: 20px;
  }
  .nav nav { display: flex; gap: 16px; flex-wrap: wrap; }
  .nav nav a { color: var(--muted); }
  .logo { font-weight: 700; color: var(--fg); }
  section { padding: 48px 0; border-top: 1px solid var(--border); }
  .hero { border-top: none; padding: 64px 0 56px; }
  .eyebrow { color: var(--accent); font-weight: 600; margin: 0; }
  h1 { font-size: clamp(2.5rem, 8vw, 4rem); line-height: 1.1; margin: 4px 0 16px; }
  h2 { font-size: 1.5rem; margin: 0 0 20px; }
  h3 { font-size: 1.1rem; margin: 0; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 640px; }
  .muted { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .btn {
    display: inline-block; padding: 10px 18px; border-radius: 8px;
    border: 1px solid var(--border); color: var(--fg); background: var(--card);
  }
  .btn:hover { text-decoration: none; border-color: var(--accent); }
  .btn.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; }
  .chips li {
    padding: 4px 12px; border-radius: 999px; font-size: 0.9rem;
    border: 1px solid var(--border); background: var(--card);
  }
  .chips.small { margin: 12px 0; }
  .chips.small li { font-size: 0.8rem; padding: 2px 10px; }
  .card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 20px;
  }
  .card p { margin: 8px 0; }
  .card ul:not(.chips) { margin: 8px 0 0; padding-left: 20px; }
  .placeholder { border-style: dashed; }
  .row { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .timeline { display: grid; gap: 16px; }
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .hike { padding: 0; overflow: hidden; }
  .hike img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .hike > :not(img) { margin-left: 20px; margin-right: 20px; }
  .hike .row { margin-top: 16px; }
  .hike > p:last-child { margin-bottom: 20px; }
  footer { padding-top: 32px; padding-bottom: 48px; border-top: 1px solid var(--border); }
</style>
